name: Build VuePress Docs

on:
  push:
    branches: [main]
  workflow_dispatch:   # 允许手动触发

permissions:
  contents: write     # 需要写权限才能 push

jobs:
  build:
    runs-on: ubuntu-latest

    steps:
      # 1. 拉代码
      - name: Checkout
        uses: actions/checkout@v4
        with:
          fetch-depth: 0   # 需要完整历史才能 push 回去

      # 2. 装 Node
      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: 20
          cache: npm

      # 3. 装依赖
      - name: Install dependencies
        run: npm ci

      # 4. 生成 sidebar 配置 + 构建 + 拷贝到 docs/
      - name: Build static site
        run: bash scripts/build-docs.sh
        # ↑ 把你原来的脚本放到 scripts/build-docs.sh

      # 5. 提交 docs/ 变动回仓库
      - name: Commit and push docs
        run: |
          git config user.name "zhicheng99"
          git config user.email "lizhicheng9@163.com"
          git add docs/
          git diff --staged --quiet || git commit -m "chore: rebuild docs [skip ci]"
          git push